{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prototype.pol",
  "scopeName": "source.pol",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#sections" },
    { "include": "#modifiers" },
    { "include": "#keywords" },
    { "include": "#data-operations" },
    { "include": "#number-with-unit" },
    { "include": "#numbers" },
    { "include": "#unit-identifiers" },
    { "include": "#bundle-reference" },
    { "include": "#type-references" },
    { "include": "#macro-identifiers" },
    { "include": "#builtin-types" },
    { "include": "#field-access" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pol",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.pol",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pol",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pol",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.pol" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.pol" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pol",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "keyword.control.directive.section.pol",
          "match": "\\b(__SPAWNS__|__CONNECTIONS__)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.pol",
          "match": "(--unique|--common)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pol",
          "match": "\\b(include|pull|define|define_multi|detail|macro|instance|spawn|alias|as|return|deploy|unpack|connect_multi|grid|topology|spawns|connections)\\b"
        },
        {
          "name": "constant.language.grid.pol",
          "match": "\\b(ON|OFF)\\b"
        },
        {
          "name": "storage.type.primitive.pol",
          "match": "\\b(int|string|switch|host|wire)\\b"
        }
      ]
    },
    "data-operations": {
      "patterns": [
        {
          "name": "support.function.data.pol",
          "match": "\\bdata\\.(define|in|out|flow)\\b"
        },
        {
          "name": "storage.type.data.pol",
          "match": "\\bdata\\b"
        }
      ]
    },
    "number-with-unit": {
      "patterns": [
        {
          "match": "\\b([0-9]+(?:\\.[0-9]+)?)(@)(bit|byte|kilo|mega|giga|milli|sec)\\b",
          "captures": {
            "1": { "name": "constant.numeric.pol" },
            "2": { "name": "keyword.operator.unit-separator.pol" },
            "3": { "name": "constant.numeric.unit.pol" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pol",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "unit-identifiers": {
      "patterns": [
        {
          "match": "(@)(bit|byte|kilo|mega|giga|milli|sec)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.unit.pol" },
            "2": { "name": "constant.numeric.unit.pol" }
          }
        }
      ]
    },
    "bundle-reference": {
      "patterns": [
        {
          "match": "(@)(bundle)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.bundle.pol" },
            "2": { "name": "variable.language.bundle.pol" }
          }
        }
      ]
    },
    "type-references": {
      "patterns": [
        {
          "match": "(&)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.type-reference.pol" },
            "2": { "name": "entity.name.type.reference.pol" }
          }
        }
      ]
    },
    "macro-identifiers": {
      "patterns": [
        {
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.macro.pol" },
            "2": { "name": "entity.name.function.macro.pol" }
          }
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "support.class.type.pol",
          "match": "\\b(machine\\.host(\\.(sender|reciever|receiver))?|machine\\.switch|machine|wire|cable|sender|receiver|reciever|ingress|egress|switch)\\b"
        }
      ]
    },
    "field-access": {
      "patterns": [
        {
          "match": "(::)(ports|field\\.[a-zA-Z_][a-zA-Z0-9_]*|[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.scope-resolution.pol" },
            "2": { "name": "variable.other.property.pol" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.scope-resolution.pol",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.pol",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.pol",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.pol",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.pol" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.curlybrace.pol",
          "match": "[{}]"
        },
        {
          "name": "punctuation.parenthesis.pol",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.pol",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.delimiter.pol",
          "match": "[:,;.]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pol",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
