include lib.machine
include lib.wire
include lib.data

pull@<header files>

define_multi{
    (&)(sender, reciever){
        machine.host.sender;
        machine.host.reciever
    }

    (&)(ingress, egress){
        machine.switch --unique 
        #if only one field is given, that means whatever being defined take up the same type
    }
    
    &switch machine.switch --common

    &cable wire --common
}


