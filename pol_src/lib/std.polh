# ==============================================================================
# Prototype.pol Master Header File: std.polh
# Defines all device models, switches, hosts, cables, macros, and rate profiles.
# ==============================================================================

include lib.machine
include lib.wire
include lib.data

// Core Component Definitions
define &sender machine.host.sender
define &reciever machine.host.reciever
define &receiver machine.host.receiver
define &ingress machine.switch --unique
define &egress machine.switch --unique
define &hub machine.switch --unique
define &switch machine.switch --common
define &cable wire --common

grid OFF

// Host Rate and Data Flow Details
detail sender:
    data send_rate;
    data.out(send_rate, 100@kilo);
    sender::field.rate("out") = send_rate;

detail reciever:
    data recieve_rate;
    data.in(recieve_rate, 300@kilo);
    reciever::field.rate("in") = recieve_rate;

detail receiver:
    data recieve_rate;
    data.in(recieve_rate, 300@kilo);
    receiver::field.rate("in") = recieve_rate;

// Switch Parameterization Macro
macro @switch switch_define(switch @switch_t,
    int a, int b, int packet_size, int buffer_size):

    data packet;
    data.define(packet, packet_size@kilo);
    data buffer[buffer_size*packet];

    switch_t::ports("in") = a;
    switch_t::ports("out") = b;

    return switch_t;

// Switch Role Details
detail ingress:
    switch_define(ingress, 1, 2, 1, 256);

detail egress:
    switch_define(egress, 2, 1, 1, 256);

detail hub:
    hub::ports("in") = 4;
    hub::ports("out") = 4;

// Multi-tier Cable Rate Profiles
detail cable:
    instance high_speed
    instance medium
    instance low_speed

    data rate;

    detail high_speed:
        data.flow(rate, 100@mega);
        high_speed::field.rate("any") = rate;

    detail medium:
        data.flow(rate, 10@mega);
        medium::field.rate("any") = rate;

    detail low_speed:
        data.flow(rate, 5@mega);
        low_speed::field.rate("any") = rate;
