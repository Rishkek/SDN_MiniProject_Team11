include lib.machine
include lib.wire
include lib.data

pull@"new.pollib"

detail machine.topology.layout:

    machine bundle[16];

    __SPAWNS__ {
        spawn cable.high_speed 4 alias hi;
        spawn cable.medium 3 alias med;
        spawn switch alias s1;
        spawn switch alias s2;
        spawn switch alias s3;
        spawn switch alias s4;
        spawn sender alias h1;
        spawn sender alias h3;
        spawn reciever alias h2;
        spawn reciever alias h4;
    }@bundle #padding=0


    __CONNECTIONS__ {
        unpack bundle;

        connect_multi {
            (h1, hi, s1);
            (h3, hi, s2);
            (s1, med, s2);
            (s2, med, s3);
            (s3, med, s4);
            (s3, hi, h4);
            (s4, hi, h2);
        }
    }


deploy:
    machine.topology.layout;