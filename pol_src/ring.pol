pull "std.polh"

topology Ring:
    spawns {
        spawn cable.high_speed as hi;
        spawn cable.medium as med;
        spawn switch as s1, s2, s3, s4;
        spawn sender as h1, h3;
        spawn reciever as h2, h4;
    }

    connections {
        (h1, hi, s1);
        (h3, hi, s3);
        (s1, med, s2);
        (s2, med, s4);
        (s4, med, s3);
        (s3, med, s1);
        (s2, hi, h4);
        (s4, hi, h2);
    }
