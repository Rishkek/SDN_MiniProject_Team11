pull "std.polh"

topology StressTest:
    spawns {
        spawn cable.high_speed as hi;
        spawn cable.medium as med;
        spawn ingress as s1;
        spawn egress as s2;
        spawn switch as s3, s4, s5, s6, s7, s8, s9, s10, s11;
        spawn sender as h1, h3;
        spawn reciever as h2, h4;
    }

    connections {
        (h1, hi, s1);
        (h3, hi, s1);
        (s2, hi, h2);
        (s2, hi, h4);

        // Direct primary route; the layered mesh supplies many alternatives.
        (s1, hi, s2);

        // Ingress to layer 1.
        (s1, med, s3);
        (s1, med, s4);
        (s1, med, s5);

        // Fully connected links between the three mesh layers.
        (s3, med, s6);
        (s3, med, s7);
        (s3, med, s8);
        (s4, med, s6);
        (s4, med, s7);
        (s4, med, s8);
        (s5, med, s6);
        (s5, med, s7);
        (s5, med, s8);

        (s6, med, s9);
        (s6, med, s10);
        (s6, med, s11);
        (s7, med, s9);
        (s7, med, s10);
        (s7, med, s11);
        (s8, med, s9);
        (s8, med, s10);
        (s8, med, s11);

        // Layer 3 to egress.
        (s9, med, s2);
        (s10, med, s2);
        (s11, med, s2);
    }
